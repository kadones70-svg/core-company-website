{
  "name": "core-company-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run content:validate",
    "build": "cross-env INCLUDE_SAMPLES=false REVIEW_BUILD=false astro build && node scripts/pagefind-index.mjs",
    "build:review": "npm run content:validate && cross-env INCLUDE_SAMPLES=true REVIEW_BUILD=true astro build && node scripts/pagefind-index.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "review:screenshots": "playwright test tests/review/screenshots.spec.ts --project=chromium",
    "content:new": "node scripts/content-new.mjs",
    "content:validate": "node scripts/content-validate.mjs",
    "content:list": "node scripts/content-list.mjs",
    "image:optimize": "node scripts/image-optimize.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "cross-env": "latest",
    "gray-matter": "latest",
    "lighthouse": "latest",
    "pagefind": "latest",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
