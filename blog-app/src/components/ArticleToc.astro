---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <>
    <details class="toc-mobile" data-testid="mobile-toc">
      <summary>이 글의 목차 <span aria-hidden="true">＋</span></summary>
      <nav aria-label="글 목차">
        <ol>
          {items.map((heading) => <li class:list={{ 'toc-depth-3': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </nav>
    </details>
    <aside class="toc-desktop" aria-label="글 목차" data-testid="desktop-toc">
      <p>ON THIS PAGE</p>
      <nav>
        <ol>
          {items.map((heading) => <li class:list={{ 'toc-depth-3': heading.depth === 3 }}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
        </ol>
      </nav>
    </aside>
  </>
)}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = links.map((link) => document.querySelector<HTMLElement>(link.hash)).filter(Boolean) as HTMLElement[];

  if (targets.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      links.forEach((link) => {
        const active = link.hash === `#${visible.target.id}`;
        link.toggleAttribute('aria-current', active);
      });
    }, { rootMargin: '-18% 0px -70% 0px', threshold: 0 });
    targets.forEach((target) => observer.observe(target));
  }

  document.querySelectorAll<HTMLAnchorElement>('.toc-mobile a, [data-toc-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', link.hash);
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .toc-mobile { display: none; margin: 28px 0 0; border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-border); }
  .toc-mobile summary { display: flex; min-height: 54px; align-items: center; justify-content: space-between; font: 700 .82rem var(--font-mono); cursor: pointer; }
  .toc-mobile[open] summary span { transform: rotate(45deg); }
  .toc-mobile ol, .toc-desktop ol { margin: 0; padding: 0; list-style: none; }
  .toc-mobile nav { padding: 0 0 20px; }
  .toc-mobile li + li { margin-top: 10px; }
  .toc-mobile a { display: inline-flex; min-height: 44px; align-items: center; color: var(--color-blue); }
  .toc-depth-3 { padding-left: 16px; }
  .toc-desktop { position: sticky; top: 110px; align-self: start; max-height: calc(100vh - 140px); overflow-y: auto; padding: 18px 0 18px 24px; border-left: 1px solid var(--color-border); }
  .toc-desktop > p { margin: 0 0 18px; font: 700 .72rem var(--font-mono); letter-spacing: .08em; color: var(--color-muted); }
  .toc-desktop li + li { margin-top: 12px; }
  .toc-desktop a { display: block; color: var(--color-muted); font-size: .84rem; line-height: 1.5; text-decoration: none; }
  .toc-desktop a:hover, .toc-desktop a[aria-current] { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-orange); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (max-width: 980px) {
    .toc-desktop { display: none; }
    .toc-mobile { display: block; }
  }
</style>
