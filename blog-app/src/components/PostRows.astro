---
import type { PostEntry } from '@/lib/posts';
import { articlePath } from '@/lib/paths';
import { formatDate, getPostSlug, isoDate, readingMinutes } from '@/lib/posts';

interface Props {
  posts: PostEntry[];
  emptyTitle?: string;
  emptyDescription?: string;
}

const {
  posts,
  emptyTitle = '아직 공개된 글이 없습니다.',
  emptyDescription = '출처와 검수 이력이 확인된 글만 공개합니다.'
} = Astro.props;
---

{posts.length ? (
  <div class="post-rows">
    {posts.map((post) => (
      <article>
        <div class="post-rows__category"><span>{post.data.category}</span><span>{post.data.contentType}</span></div>
        <div class="post-rows__body"><h2><a href={articlePath(getPostSlug(post))}>{post.data.title}</a></h2><p>{post.data.summary}</p><ul aria-label="태그">{post.data.tags.slice(0, 3).map((tag) => <li>#{tag}</li>)}</ul></div>
        <div class="post-rows__meta"><time datetime={isoDate(post.data.updatedAt)}>{formatDate(post.data.updatedAt)}</time><span>{readingMinutes(post)}분</span></div>
      </article>
    ))}
  </div>
) : (
  <div class="post-empty" role="status"><span aria-hidden="true">＋</span><h2>{emptyTitle}</h2><p>{emptyDescription}</p></div>
)}

<style>
  .post-rows { border-top: 1px solid var(--color-ink); }
  .post-rows article { display: grid; grid-template-columns: minmax(145px, .55fr) minmax(0, 2fr) auto; gap: 36px; padding: 32px 0; border-bottom: 1px solid var(--color-border); }
  .post-rows__category { display: grid; align-content: start; gap: 8px; font: 700 .75rem var(--font-mono); color: var(--color-orange-accessible); }
  .post-rows__category span:last-child { color: var(--color-muted); font-weight: 500; }
  .post-rows h2 { margin: 0 0 10px; font-size: 1.45rem; line-height: 1.42; }
  .post-rows h2 a { color: inherit; text-decoration-color: var(--color-orange); text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .post-rows__body > p { margin: 0; color: var(--color-muted); line-height: 1.65; }
  .post-rows ul { display: flex; flex-wrap: wrap; gap: 8px 12px; margin: 14px 0 0; padding: 0; list-style: none; color: var(--color-blue); font-size: .78rem; }
  .post-rows__meta { display: flex; gap: 16px; font: .75rem var(--font-mono); color: var(--color-muted); white-space: nowrap; }
  .post-empty { padding: 52px; border: 1px solid var(--color-border); background: var(--color-surface); }
  .post-empty > span { font: 2rem var(--font-mono); color: var(--color-orange); }
  .post-empty h2 { margin: 16px 0 8px; font-size: 1.55rem; }
  .post-empty p { margin: 0; color: var(--color-muted); }
  @media (max-width: 760px) {
    .post-rows article { grid-template-columns: 1fr; gap: 12px; padding: 28px 0; }
    .post-rows__category { display: flex; flex-wrap: wrap; }
    .post-rows__meta { justify-content: space-between; }
    .post-empty { padding: 34px 24px; }
  }
</style>
