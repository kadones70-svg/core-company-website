---
import { SITE } from '../config/site';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const validItems = items.filter((item) => item.label.trim().length > 0);
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: validItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href ?? Astro.url.pathname, SITE.siteUrl).toString()
  }))
}).replace(/</g, '\\u003c');
---

<nav class="breadcrumbs container" aria-label="현재 위치 경로" data-pagefind-ignore="all">
  <ol>
    {validItems.map((item, index) => {
      const isLast = index === validItems.length - 1;
      return (
        <li>
          {item.href && !isLast ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current={isLast ? 'page' : undefined}>{item.label}</span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<script type="application/ld+json" set:html={breadcrumbJsonLd} is:inline />
