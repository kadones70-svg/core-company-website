---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCta from '@/components/ContactCta.astro';
import EditorialDiagram from '@/components/EditorialDiagram.astro';
import { CATEGORIES } from '@/config/content';
import { articlePath, withBase } from '@/lib/paths';
import { formatDate, getPostSlug, getVisiblePosts, isoDate, readingMinutes } from '@/lib/posts';

const posts = await getVisiblePosts();
const featuredPosts = posts.filter((post) => post.data.featured);
const curatedFeatured = featuredPosts
  .filter((post) => post.data.featuredOrder != null)
  .sort((a, b) => (a.data.featuredOrder ?? 0) - (b.data.featuredOrder ?? 0))[0];
const featured = curatedFeatured ?? featuredPosts[0] ?? posts[0];
const editorsPick = posts.find((post) => post.id !== featured?.id) ?? featured;
const latest = posts.slice(0, 6);
---

<BaseLayout
  title="AI와 IoT를 현장에 적용하는 방법 | Core Company Blog"
  description="숙박·오피스·중소기업 운영자를 위한 AI, IoT, 자동화 도입 기준과 실무 가이드"
  canonicalPath="/blog/"
>
  <main id="main-content" data-pagefind-ignore>
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__main">
        <p class="eyebrow">CORE COMPANY EDITORIAL / 2026</p>
        <h1 id="hero-title">AI와 IoT를 현장에 적용하는 방법</h1>
        <p class="hero__description">숙박·오피스·중소기업 운영자가 기술을 도입하기 전에 확인해야 할 기준을, 실제 업무 흐름과 공간 관점에서 쉽게 정리합니다.</p>
      </div>
      <ol class="principles" aria-label="편집 원칙 요약">
        <li><span>01 / PRACTICAL</span><strong>기술보다 운영 문제를 먼저 봅니다.</strong></li>
        <li><span>02 / VERIFIED</span><strong>출처와 수정 이력을 공개합니다.</strong></li>
      </ol>
    </section>

    <section class="search-feature section-shell" aria-labelledby="search-title">
      <div class="search-panel">
        <p class="section-index">01 / SEARCH</p>
        <h2 id="search-title">무엇을 검토하고 계신가요?</h2>
        <form class="search-form" role="search" action={withBase('/search/')} method="get">
          <label for="home-search">블로그 검색</label>
          <div class="search-form__row">
            <input id="home-search" name="q" type="search" placeholder="예: 무인 체크인, 문서 AI, 구축 비용" autocomplete="off" />
            <button type="submit">검색</button>
          </div>
        </form>
        <div class="popular-searches" aria-label="인기 검색어">
          <span>POPULAR</span>
          {['무인 체크인', 'RAG', 'AI 도입 비용'].map((term) => <a href={`${withBase('/search/')}?q=${encodeURIComponent(term)}`}>{term}</a>)}
        </div>
      </div>

      <article class="featured-article">
        <div class="featured-article__copy">
          {featured ? (
            <>
              <div class="featured-article__heading">
                <p class="section-index">FEATURED ARTICLE</p>
                <p class="meta-line"><span>{featured.data.category}</span><span>{featured.data.contentType}</span><span>{readingMinutes(featured)}분</span></p>
                <h2><a href={articlePath(getPostSlug(featured))}>{featured.data.title}</a></h2>
              </div>
              <div class="featured-article__summary">
                <p>{featured.data.summary}</p>
                <a class="text-link" href={articlePath(getPostSlug(featured))}>글 읽기 <span aria-hidden="true">→</span></a>
              </div>
            </>
          ) : (
            <div class="empty-state"><h2>첫 글을 준비하고 있습니다.</h2><p>검수된 콘텐츠가 등록되면 이곳에서 먼저 소개합니다.</p></div>
          )}
        </div>
      </article>
    </section>

    <section class="section-shell section-block" aria-labelledby="industry-title">
      <div class="section-heading"><p class="section-index">02 / START BY INDUSTRY</p><h2 id="industry-title">업무 환경에서 시작하기</h2><p>기술 이름보다 지금 운영 중인 공간과 업무를 기준으로 살펴보세요.</p></div>
      <div class="industry-grid">
        {CATEGORIES.slice(0, 4).map((category, index) => (
          <a href={withBase(`/category/${category.slug}/`)}>
            <span>0{index + 1}</span><h3>{category.name}</h3><p>{category.description}</p><b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="section-shell section-block" aria-labelledby="pick-title">
      <div class="section-heading section-heading--row"><div><p class="section-index">03 / EDITOR'S PICK</p><h2 id="pick-title">편집자가 고른 글</h2></div><a class="text-link" href={withBase('/category/ai-adoption-cost/')}>AI 도입 글 전체 보기 <span aria-hidden="true">→</span></a></div>
      <article class="editors-pick">
        <EditorialDiagram />
        <div class="editors-pick__copy">
          {editorsPick ? (
            <>
              <p class="meta-line"><span>{editorsPick.data.category}</span><span>{editorsPick.data.contentType}</span></p>
              <h3><a href={articlePath(getPostSlug(editorsPick))}>{editorsPick.data.title}</a></h3>
              <p>{editorsPick.data.summary}</p>
              <dl><div><dt>수정</dt><dd><time datetime={isoDate(editorsPick.data.updatedAt)}>{formatDate(editorsPick.data.updatedAt)}</time></dd></div><div><dt>읽기</dt><dd>{readingMinutes(editorsPick)}분</dd></div></dl>
              <a class="button button--ink" href={articlePath(getPostSlug(editorsPick))}>판단 기준 살펴보기</a>
            </>
          ) : (
            <div class="empty-state"><h3>편집 글을 준비하고 있습니다.</h3><p>출처와 검수 이력이 확인된 글만 공개합니다.</p></div>
          )}
        </div>
      </article>
    </section>

    <section class="section-shell section-block" aria-labelledby="latest-title">
      <div class="section-heading section-heading--row"><div><p class="section-index">04 / LATEST ARTICLES</p><h2 id="latest-title">최근 업데이트</h2></div><a class="text-link" href={withBase('/search/')}>모든 글 검색 <span aria-hidden="true">→</span></a></div>
      {latest.length ? (
        <div class="latest-list">
          {latest.map((post) => (
            <article>
              <p class="latest-list__category">{post.data.category}</p>
              <div><h3><a href={articlePath(getPostSlug(post))}>{post.data.title}</a></h3><p>{post.data.summary}</p></div>
              <p class="latest-list__meta"><time datetime={isoDate(post.data.updatedAt)}>{formatDate(post.data.updatedAt)}</time><span>{readingMinutes(post)}분</span></p>
            </article>
          ))}
        </div>
      ) : <div class="empty-state empty-state--bordered"><h3>공개된 글이 아직 없습니다.</h3><p>출처와 검수 이력이 확인된 글부터 순서대로 공개합니다.</p></div>}
    </section>

    <section class="section-shell section-block" aria-labelledby="topics-title">
      <div class="section-heading"><p class="section-index">05 / BROWSE BY TOPIC</p><h2 id="topics-title">주제별로 살펴보기</h2></div>
      <div class="topic-grid">
        {CATEGORIES.map((category) => (
          <a class="topic-card" style={`--topic-accent:${category.accent}`} href={withBase(`/category/${category.slug}/`)}>
            <h3>{category.name}</h3><p>{category.description}</p><span>관련 글 보기 <b aria-hidden="true">→</b></span>
          </a>
        ))}
      </div>
    </section>

    <ContactCta position="home-bottom" />
  </main>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(280px, .7fr); gap: clamp(44px, 7vw, 108px); padding-top: clamp(72px, 9vw, 128px); padding-bottom: clamp(72px, 9vw, 124px); }
  .hero h1 { max-width: 900px; margin: 18px 0 28px; font-size: clamp(4.25rem, 6.2vw, 5.25rem); line-height: 1.05; letter-spacing: -.055em; }
  .hero__description { max-width: 710px; margin: 0; font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.75; color: var(--color-muted); }
  .principles { align-self: end; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-orange); }
  .principles li { display: grid; gap: 9px; padding: 24px 0; border-bottom: 1px solid var(--color-border); }
  .principles span, .section-index { margin: 0; font: 700 .75rem/1.4 var(--font-mono); letter-spacing: .07em; color: var(--color-orange-accessible); }
  .principles strong { font-size: 1rem; line-height: 1.6; }
  .search-feature { padding-bottom: clamp(80px, 9vw, 130px); }
  .search-panel { display: grid; grid-template-columns: .6fr 1fr; gap: 24px 54px; align-items: end; padding: 34px 0; border-top: 1px solid var(--color-orange); border-bottom: 1px solid var(--color-border); }
  .search-panel h2 { margin: 0; font-size: clamp(2rem, 3vw, 2.7rem); line-height: 1.15; }
  .search-form { grid-column: 1 / -1; }
  .search-form label { display: block; margin-bottom: 9px; font: 700 .78rem var(--font-mono); }
  .search-form__row { display: grid; grid-template-columns: 1fr auto; }
  .search-form input { min-width: 0; height: 64px; padding: 0 20px; border: 1px solid var(--color-ink); border-right: 0; border-radius: 0; background: var(--color-surface); font: inherit; font-size: 1rem; }
  .search-form button { min-width: 112px; border: 1px solid var(--color-ink); border-radius: 0; color: #fff; background: var(--color-ink); font: 700 .9rem var(--font-mono); cursor: pointer; }
  .popular-searches { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; }
  .popular-searches span { font: 700 .72rem var(--font-mono); color: var(--color-muted); }
  .popular-searches a { color: var(--color-blue); text-underline-offset: 3px; }
  .featured-article { margin-top: 48px; border: 1px solid var(--color-border); border-top: 4px solid var(--color-orange); background: var(--color-surface); }
  .featured-article__copy { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr); gap: clamp(40px, 7vw, 112px); align-items: end; padding: clamp(40px, 6vw, 80px); }
  .featured-article__heading { min-width: 0; }
  .featured-article h2 { max-width: 760px; margin: 20px 0 0; font-size: clamp(2.5rem, 4.5vw, 4.25rem); line-height: 1.12; letter-spacing: -.035em; }
  .featured-article h2 a, .latest-list h3 a, .editors-pick h3 a { color: inherit; text-decoration: none; }
  .featured-article__summary { max-width: 430px; padding-top: 30px; border-top: 1px solid var(--color-border); }
  .featured-article__summary p { margin: 0 0 28px; font-size: 1.05rem; line-height: 1.8; color: var(--color-muted); }
  .meta-line { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 0; font: 700 .75rem var(--font-mono); color: var(--color-muted); }
  .meta-line span + span::before { content: '·'; margin-right: 16px; color: var(--color-orange); }
  .section-block { padding-top: clamp(80px, 8vw, 116px); padding-bottom: clamp(80px, 8vw, 116px); }
  .section-block + .section-block { border-top: 1px solid var(--color-border); }
  .section-heading { max-width: 760px; margin-bottom: 44px; }
  .section-heading h2 { margin: 12px 0 12px; font-size: clamp(2.35rem, 4vw, 3.2rem); line-height: 1.12; letter-spacing: -.04em; }
  .section-heading > p:last-child { margin: 0; color: var(--color-muted); line-height: 1.7; }
  .section-heading--row { display: flex; max-width: none; justify-content: space-between; align-items: end; gap: 30px; }
  .section-heading--row h2 { margin-bottom: 0; }
  .industry-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-ink); }
  .industry-grid a { position: relative; min-height: 260px; padding: 26px; border-right: 1px solid var(--color-border); color: inherit; text-decoration: none; transition: background-color 120ms ease, transform 120ms ease; }
  .industry-grid a:last-child { border-right: 0; }
  .industry-grid a:hover { background: var(--color-surface); transform: translateY(-2px); }
  .industry-grid span { font: 700 .75rem var(--font-mono); color: var(--color-orange-accessible); }
  .industry-grid h3 { margin: 54px 0 14px; font-size: 1.45rem; }
  .industry-grid p { margin: 0; line-height: 1.65; color: var(--color-muted); }
  .industry-grid b { position: absolute; right: 26px; bottom: 22px; color: var(--color-blue); }
  .editors-pick { display: grid; grid-template-columns: 1.12fr .88fr; border-top: 4px solid var(--color-orange); }
  .editors-pick > :global(.editorial-diagram) { border-top-left-radius: 0; border-top-right-radius: 0; }
  .editors-pick__copy { padding: clamp(36px, 6vw, 80px); border: 1px solid var(--color-border); border-top: 0; background: var(--color-surface); }
  .editors-pick h3 { margin: 20px 0; font-size: clamp(2rem, 3vw, 2.8rem); line-height: 1.2; }
  .editors-pick__copy > p:not(.meta-line) { color: var(--color-muted); line-height: 1.75; }
  .editors-pick dl { display: flex; gap: 28px; margin: 28px 0; }
  .editors-pick dl div { display: flex; gap: 8px; }
  .editors-pick dt { font: 700 .75rem var(--font-mono); color: var(--color-muted); }
  .editors-pick dd { margin: 0; font-size: .85rem; }
  .latest-list { border-top: 1px solid var(--color-ink); }
  .latest-list article { display: grid; grid-template-columns: minmax(130px, .55fr) minmax(0, 2.2fr) auto; gap: 34px; padding: 28px 0; border-bottom: 1px solid var(--color-border); align-items: start; }
  .latest-list__category { margin: 4px 0 0; font: 700 .75rem var(--font-mono); color: var(--color-orange-accessible); }
  .latest-list h3 { margin: 0 0 8px; font-size: 1.35rem; line-height: 1.4; }
  .latest-list article > div > p { margin: 0; color: var(--color-muted); line-height: 1.6; }
  .latest-list__meta { display: flex; gap: 16px; margin: 5px 0 0; font: .75rem var(--font-mono); color: var(--color-muted); white-space: nowrap; }
  .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .topic-card { min-height: 220px; padding: 28px; border: 1px solid var(--color-border); border-top: 4px solid var(--topic-accent); border-radius: 18px; color: inherit; background: var(--color-surface); text-decoration: none; transition: transform 120ms ease, border-color 120ms ease; }
  .topic-card:hover { transform: translateY(-2px); border-color: var(--color-ink); }
  .topic-card h3 { margin: 6px 0 16px; font-size: 1.4rem; }
  .topic-card p { min-height: 76px; margin: 0 0 20px; color: var(--color-muted); line-height: 1.65; }
  .topic-card span { font: 700 .78rem var(--font-mono); color: var(--color-blue); }
  .empty-state { max-width: 620px; }
  .empty-state h2, .empty-state h3 { margin-bottom: 10px; }
  .empty-state p { color: var(--color-muted); line-height: 1.7; }
  .empty-state--bordered { padding: 40px; border: 1px solid var(--color-border); background: var(--color-surface); }
  @media (max-width: 1020px) {
    .hero { grid-template-columns: 1fr; }
    .hero h1 { font-size: clamp(3.6rem, 7vw, 4.8rem); }
    .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .featured-article__copy, .editors-pick { grid-template-columns: 1fr; }
    .featured-article__summary { max-width: 700px; }
    .industry-grid { grid-template-columns: 1fr 1fr; }
    .industry-grid a:nth-child(2) { border-right: 0; }
    .industry-grid a:nth-child(-n+2) { border-bottom: 1px solid var(--color-border); }
    .topic-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .hero { gap: 48px; padding-top: 60px; padding-bottom: 72px; }
    .hero h1 { margin-top: 16px; font-size: clamp(2.5rem, 11vw, 3rem); line-height: 1.08; }
    .hero h1 br { display: none; }
    .hero__description { font-size: 1rem; }
    .principles { grid-template-columns: 1fr; gap: 0; }
    .search-panel { grid-template-columns: 1fr; align-items: start; }
    .search-panel > * { grid-column: 1; }
    .search-form__row { grid-template-columns: 1fr; gap: 10px; }
    .search-form input { border-right: 1px solid var(--color-ink); }
    .search-form button { min-height: 52px; }
    .featured-article { margin-top: 32px; }
    .featured-article__copy, .editors-pick__copy { padding: 28px 22px 34px; }
    .featured-article__copy { gap: 30px; }
    .featured-article h2 { font-size: clamp(2.25rem, 10vw, 3rem); }
    .featured-article__summary { padding-top: 24px; }
    .section-heading--row { align-items: start; flex-direction: column; }
    .industry-grid { grid-template-columns: 1fr; }
    .industry-grid a { min-height: 220px; border-right: 0; border-bottom: 1px solid var(--color-border); }
    .industry-grid a:last-child { border-bottom: 0; }
    .latest-list article { grid-template-columns: 1fr; gap: 10px; }
    .latest-list__meta { justify-content: space-between; }
    .topic-grid { grid-template-columns: 1fr; }
    .topic-card p { min-height: 0; }
  }
</style>
