---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCta from '@/components/ContactCta.astro';
import { CATEGORIES, TITLE_FONT_STACKS } from '@/config/content';
import { articlePath, withBase } from '@/lib/paths';
import { getPostSlug, getVisiblePosts, readingMinutes } from '@/lib/posts';

const posts = await getVisiblePosts();
const featuredPosts = posts.filter((post) => post.data.featured);
const curatedFeatured = featuredPosts
  .filter((post) => post.data.featuredOrder != null)
  .sort((a, b) => (a.data.featuredOrder ?? 0) - (b.data.featuredOrder ?? 0))[0];
const featured = curatedFeatured ?? featuredPosts[0] ?? posts[0];
const picks = posts.filter((post) => post.id !== featured?.id && post.data.thumbnail).slice(0, 3);
const featuredTitleFontStack = featured?.data.titleFont ? TITLE_FONT_STACKS[featured.data.titleFont] : undefined;
---

<BaseLayout
  title="AI와 IoT를 현장에 적용하는 방법 | Core Company Blog"
  description="숙박·오피스·중소기업 운영자를 위한 AI, IoT, 자동화 도입 기준과 실무 가이드"
  canonicalPath="/blog/"
>
  <main id="main-content" data-pagefind-ignore>

    <!-- HERO -->
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero__text">
        <p class="eyebrow">CORE COMPANY EDITORIAL · 2026</p>
        <h1 id="hero-title">AI와 IoT를<br />현장에 적용하는 방법</h1>
        <p class="hero__desc">숙박·오피스·중소기업 운영자가 기술을 도입하기 전에 확인해야 할 기준을, 실제 업무 흐름과 공간 관점에서 쉽게 정리합니다.</p>
        <div class="hero__chips">
          <span class="chip">기술보다 운영 문제를 먼저</span>
          <span class="chip">출처·수정 이력을 공개</span>
        </div>
        <form role="search" class="hero-search" action={withBase('/search/')} method="get" aria-label="블로그 글 검색">
          <input class="hero-search__input" name="q" type="search" placeholder="글 검색: 무인 체크인, 문서 AI, 구축 비용…" autocomplete="off" aria-label="블로그 검색어" />
          <button class="hero-search__btn" type="submit">검색</button>
        </form>
      </div>
      <figure class="hero__visual">
        <img src="/blog/images/hero/hero.webp" alt="AI와 IoT가 적용된 소규모 사업장 공간" loading="eager" decoding="async" width="1600" height="1200" />
      </figure>
    </section>

    <!-- FEATURED -->
    {featured && (
      <section class="section-shell featured-wrap" aria-labelledby="featured-title">
        <article class="featured reveal">
          <div class="featured__media">
            {featured.data.thumbnail
              ? <img src={featured.data.thumbnail} alt={featured.data.thumbnailAlt} loading="lazy" decoding="async" width="1280" height="800" />
              : <div class="ph-fallback" aria-hidden="true"></div>}
          </div>
          <div class="featured__body">
            <p class="kicker"><strong>이번 주 추천</strong><span>{featured.data.category}</span><span>{featured.data.contentType}</span><span>{readingMinutes(featured)}분</span></p>
            <h2 id="featured-title" style={featuredTitleFontStack ? `--title-font: ${featuredTitleFontStack}` : undefined}><a href={articlePath(getPostSlug(featured))}>{featured.data.title}</a></h2>
            <p class="featured__desc">{featured.data.summary}</p>
            <a class="btn" href={articlePath(getPostSlug(featured))}>글 읽기 <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </section>
    )}

    <!-- CATEGORIES -->
    <section class="section-shell block" aria-labelledby="industry-title">
      <div class="block__head">
        <div>
          <p class="eyebrow">Start by industry</p>
          <h2 id="industry-title">업무 환경에서 시작하기</h2>
        </div>
        <p class="block__sub">기술 이름보다 지금 운영 중인 공간과 업무를 기준으로 살펴보세요.</p>
      </div>
      <div class="cat-grid">
        {CATEGORIES.map((category) => (
          <a class="cat-card reveal" href={withBase(`/category/${category.slug}/`)}>
            <div class="cat-card__media"><img src={category.image} alt={category.name} loading="lazy" decoding="async" /></div>
            <div class="cat-card__body">
              <span class="cat-card__bar" style={`background:${category.accent}`}></span>
              <h3>{category.name}</h3>
              <p>{category.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- EDITOR'S PICK -->
    {picks.length > 0 && (
      <section class="section-shell block" aria-labelledby="pick-title">
        <div class="block__head">
          <div>
            <p class="eyebrow">Editor's pick</p>
            <h2 id="pick-title">편집자가 고른 글</h2>
          </div>
        </div>
        <div class="pick-grid">
          {picks.map((post) => (
            <a class="pick-card reveal" href={articlePath(getPostSlug(post))}>
              <div class="pick-card__media"><img src={post.data.thumbnail} alt={post.data.thumbnailAlt} loading="lazy" decoding="async" /></div>
              <div class="pick-card__body">
                <p class="kicker"><span>{post.data.category}</span><span>{readingMinutes(post)}분</span></p>
                <h3>{post.data.title}</h3>
                <p>{post.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- TRUST BAND -->
    <section class="trust" aria-labelledby="trust-title">
      <div class="section-shell trust__inner">
        <div class="trust__head">
          <p class="eyebrow">Why trust this blog</p>
          <h2 id="trust-title">과장 없이, 확인한 것만 씁니다</h2>
        </div>
        <div class="trust__items">
          <div class="trust__item reveal">
            <span class="trust__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h12M4 10h12M4 15h8"/><circle cx="18" cy="16" r="3"/></svg></span>
            <div><h3>출처를 공개합니다</h3><p>모든 글에 확인한 출처와 확인 날짜를 함께 답니다.</p></div>
          </div>
          <div class="trust__item reveal">
            <span class="trust__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9a8 8 0 1 1 0 6"/><path d="M4 4v6h6"/><path d="M12 8v4l3 2"/></svg></span>
            <div><h3>수정 이력을 남깁니다</h3><p>언제 무엇을 누가 고쳤는지 글 안에 투명하게 기록합니다.</p></div>
          </div>
          <div class="trust__item reveal">
            <span class="trust__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><h3>사람이 검수합니다</h3><p>AI가 초안을 돕고, 공개 전에는 사람이 검토·승인합니다.</p></div>
          </div>
        </div>
      </div>
    </section>

    <ContactCta position="home-bottom" />
  </main>
</BaseLayout>

<style>
  .section-shell { width: min(var(--container), calc(100% - 3rem)); margin-inline: auto; }

  /* HERO */
  .hero { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(40px, 5vw, 72px); align-items: center; padding-block: clamp(56px, 7vw, 92px) clamp(40px, 5vw, 64px); }
  .eyebrow { margin: 0; font: 700 0.75rem/1.4 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-orange-accessible); }
  .hero h1 { margin: 16px 0 0; font-size: clamp(2.6rem, 5vw, 4rem); line-height: 1.12; letter-spacing: -0.01em; }
  .hero__desc { max-width: 46ch; margin: 20px 0 0; font-size: clamp(1.02rem, 1.3vw, 1.18rem); line-height: 1.75; color: var(--color-muted); }
  .hero__chips { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .chip { display: inline-flex; align-items: center; padding: 8px 15px; border-radius: 999px; background: #fbe8da; color: #b7490a; font-weight: 700; font-size: 0.82rem; }
  .hero__visual { margin: 0; aspect-ratio: 4 / 3; max-width: 100%; border-radius: 24px; overflow: hidden; background: #f6dac8; box-shadow: 0 24px 50px -24px rgba(201, 116, 60, 0.34); }
  .hero__visual img, .featured__media img, .cat-card__media img, .pick-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* FEATURED */
  .featured-wrap { padding-block: clamp(16px, 3vw, 28px) clamp(10px, 2vw, 16px); }
  .featured { display: grid; grid-template-columns: 1.1fr 1fr; gap: 0; border: 1px solid var(--color-border); border-radius: 24px; overflow: hidden; background: var(--color-surface); }
  .featured__media { min-height: 340px; background: #f6dac8; }
  .featured__body { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 4vw, 44px); min-width: 0; }
  .kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 0 0 14px; font: 700 0.78rem var(--font-mono); color: var(--color-muted); }
  .kicker strong { color: var(--color-orange-accessible); letter-spacing: 0.04em; }
  .kicker span + span::before, .kicker strong + span::before { content: '·'; margin-right: 10px; color: var(--color-border); }
  .featured h2 { margin: 0; font-size: clamp(1.7rem, 2.6vw, 2.2rem); line-height: 1.2; }
  .featured h2 a, .pick-card h3 a { color: inherit; text-decoration: none; }
  .featured__desc { margin: 16px 0 24px; color: var(--color-muted); font-size: 1.02rem; line-height: 1.75; }
  .btn { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 22px; border-radius: 999px; background: var(--color-orange); color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; }
  .btn:hover { background: var(--color-orange-accessible); }

  /* SECTION BLOCK */
  .block { padding-block: clamp(48px, 6vw, 80px); }
  .block__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; flex-wrap: wrap; margin-bottom: 28px; }
  .block__head h2 { margin: 10px 0 0; font-size: clamp(1.7rem, 2.6vw, 2.1rem); line-height: 1.2; }
  .block__sub { max-width: 34ch; margin: 0; color: var(--color-muted); font-size: 0.95rem; line-height: 1.6; }

  /* CATEGORY CARDS */
  .cat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .cat-card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); color: inherit; text-decoration: none; transition: transform 160ms ease, box-shadow 160ms ease; }
  .cat-card:hover { transform: translateY(-3px); box-shadow: 0 18px 36px -24px rgba(80, 60, 40, 0.35); }
  .cat-card__media { aspect-ratio: 16 / 10; background: #f6dac8; }
  .cat-card__body { padding: 18px 18px 22px; }
  .cat-card__bar { display: block; width: 30px; height: 4px; border-radius: 2px; margin-bottom: 12px; }
  .cat-card__body h3 { margin: 0; font-size: 1.18rem; }
  .cat-card__body p { margin: 7px 0 0; font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; }

  /* EDITOR'S PICK */
  .pick-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .pick-card { display: block; border: 1px solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface); color: inherit; text-decoration: none; transition: transform 160ms ease; }
  .pick-card:hover { transform: translateY(-3px); }
  .pick-card:hover h3 { color: var(--color-orange-accessible); }
  .pick-card__media { aspect-ratio: 16 / 10; background: #f6dac8; }
  .pick-card__body { padding: 20px; }
  .pick-card__body .kicker { margin-bottom: 10px; color: var(--color-orange-accessible); }
  .pick-card__body .kicker span { color: var(--color-orange-accessible); }
  .pick-card h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; transition: color 140ms ease; }
  .pick-card__body > p:last-child { margin: 10px 0 0; font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; }

  /* TRUST BAND */
  .trust { margin-top: clamp(32px, 5vw, 56px); border-top: 1px solid var(--color-border); background: linear-gradient(180deg, #fbe8da, #f6dac8); }
  .trust__inner { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; padding-block: clamp(40px, 5vw, 56px); }
  .trust__head { grid-column: 1 / -1; max-width: 42ch; }
  .trust__head h2 { margin: 10px 0 0; font-size: clamp(1.5rem, 2.3vw, 1.9rem); }
  .trust__item { display: flex; gap: 14px; }
  .trust__icon { flex: none; width: 44px; height: 44px; border-radius: 12px; background: #fff; display: flex; align-items: center; justify-content: center; color: var(--color-orange); }
  .trust__item h3 { margin: 0; font-size: 1.05rem; }
  .trust__item p { margin: 5px 0 0; font-size: 0.9rem; color: var(--color-body, #584a3c); line-height: 1.6; }

  .ph-fallback { width: 100%; height: 100%; min-height: 340px; background: #f6dac8; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 32px; }
    .hero__visual { aspect-ratio: 16 / 10; }
    .featured { grid-template-columns: 1fr; }
    .featured__media { min-height: 0; aspect-ratio: 16 / 9; }
    .cat-grid, .pick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trust__inner { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 560px) {
    .hero h1 br { display: none; }
    .cat-grid, .pick-grid { grid-template-columns: 1fr; }
  }
</style>
