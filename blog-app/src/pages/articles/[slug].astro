---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleToc from '@/components/ArticleToc.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactCta from '@/components/ContactCta.astro';
import EditorialDiagram from '@/components/EditorialDiagram.astro';
import { categoryToSlug, tagToSlug } from '@/config/content';
import { SITE } from '@/config/site';
import { articlePath, withBase } from '@/lib/paths';
import { formatDate, getPostSlug, getVisiblePosts, isoDate, readingMinutes, type PostEntry } from '@/lib/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: getPostSlug(post) }, props: { post, allPosts: posts } }));
}

const { post, allPosts } = Astro.props as {
  post: CollectionEntry<'posts'>;
  allPosts: PostEntry[];
};
const slug = getPostSlug(post);
const { Content, headings } = await render(post);
const related = post.data.relatedPosts
  .map((relatedSlug) => allPosts.find((candidate) => getPostSlug(candidate) === relatedSlug))
  .filter(Boolean) as PostEntry[];
const canonicalPath = articlePath(slug);
const articleImage = post.data.thumbnail ? new URL(post.data.thumbnail, 'https://corecompany.net').href : undefined;
const tocHeadings = [
  ...headings,
  { depth: 2, slug: 'sources-title', text: '출처' },
  { depth: 2, slug: 'change-log-title', text: '변경 이력' },
  { depth: 2, slug: 'credit-title', text: '작성과 검수' }
];
const articleJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: isoDate(post.data.publishedAt),
    dateModified: isoDate(post.data.updatedAt),
    author: { '@id': SITE.organizationId },
    publisher: { '@id': SITE.organizationId },
    mainEntityOfPage: `https://corecompany.net${canonicalPath}`,
    ...(articleImage ? { image: articleImage } : {}),
    articleSection: post.data.category,
    keywords: post.data.tags.join(', ')
};
---

<BaseLayout title={`${post.data.title} | Core Company Blog`} description={post.data.description} canonicalPath={canonicalPath} type="article" image={articleImage} jsonLd={articleJsonLd} analyticsArticle={slug} analyticsCategory={categoryToSlug(post.data.category)}>
  <main id="main-content">
    <header class="article-header section-shell">
      <Breadcrumbs items={[{ label: '블로그', href: withBase('/') }, { label: post.data.category, href: withBase(`/category/${categoryToSlug(post.data.category)}/`) }, { label: post.data.title }]} />
      {post.data.sample && <p class="sample-notice"><strong>검수용 샘플</strong> 실제 고객 사례가 아니며 운영 배포에서 제외됩니다.</p>}
      <p class="article-category" data-pagefind-filter="category" data-pagefind-meta="category">{post.data.category} / {post.data.contentType}</p>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-summary" data-pagefind-meta="summary">{post.data.summary}</p>
      <dl class="article-meta">
        <div><dt>게시</dt><dd><time datetime={isoDate(post.data.publishedAt)}>{formatDate(post.data.publishedAt)}</time></dd></div>
        <div><dt>수정</dt><dd><time datetime={isoDate(post.data.updatedAt)} data-pagefind-meta="updated">{formatDate(post.data.updatedAt)}</time></dd></div>
        <div><dt>작성</dt><dd>{post.data.author}</dd></div>
        <div><dt>검수</dt><dd>{post.data.reviewer}</dd></div>
        <div><dt>읽기</dt><dd data-pagefind-meta="readingTime">약 {readingMinutes(post)}분</dd></div>
      </dl>
      <ul class="tag-list" aria-label="태그">
        {post.data.tags.map((tag) => <li><a href={withBase(`/tag/${tagToSlug(tag)}/`)} data-pagefind-filter="tag">#{tag}</a></li>)}
      </ul>
      <ArticleToc headings={tocHeadings} variant="mobile" />
    </header>

    <div class="article-layout section-shell">
      <article class="article-content" data-pagefind-body>
        <div class="article-lead-diagram" data-pagefind-ignore><EditorialDiagram compact /></div>
        <Content />

        <ContactCta position="article-inline" article={slug} category={categoryToSlug(post.data.category)} heading="이 기준을 우리 환경에 대입해 보세요" description="현재 운영 흐름을 먼저 확인하면 필요한 기술 범위를 줄일 수 있습니다." />

        <section class="sources" aria-labelledby="sources-title" data-testid="article-sources">
          <h2 id="sources-title">출처</h2>
          {post.data.sources.length ? (
            <ol>
              {post.data.sources.map((source) => (
                <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><dl><div><dt>확인일</dt><dd><time datetime={isoDate(source.checkedAt)}>{formatDate(source.checkedAt)}</time></dd></div><div><dt>자료 유형</dt><dd>{source.type}</dd></div></dl></li>
              ))}
            </ol>
          ) : <p>현재 등록된 외부 출처가 없습니다.</p>}
        </section>

        <section class="change-log" aria-labelledby="change-log-title" data-testid="article-change-log">
          <h2 id="change-log-title">변경 이력</h2>
          <div class="table-scroll" tabindex="0" aria-label="변경 이력 표, 가로로 스크롤할 수 있습니다">
            <table><caption>이 글의 수정과 검수 기록</caption><thead><tr><th scope="col">날짜</th><th scope="col">변경 내용</th><th scope="col">검수자</th></tr></thead><tbody>{post.data.changeLog.map((item) => <tr><th scope="row"><time datetime={isoDate(item.date)}>{formatDate(item.date)}</time></th><td>{item.description}</td><td>{item.reviewer}</td></tr>)}</tbody></table>
          </div>
        </section>

        <section class="credit-box" aria-labelledby="credit-title">
          <h2 id="credit-title">작성과 검수</h2>
          <dl><div><dt>작성</dt><dd>{post.data.author}</dd></div><div><dt>기술 검토</dt><dd>{post.data.reviewer}</dd></div>{post.data.aiDisclosure && <div><dt>AI 활용 공개</dt><dd>{post.data.aiDisclosure}</dd></div>}</dl>
        </section>
      </article>
      <ArticleToc headings={tocHeadings} variant="desktop" />
    </div>

    <section class="related section-shell" aria-labelledby="related-title" data-pagefind-ignore>
      <p class="section-index">RELATED ARTICLES</p><h2 id="related-title">함께 읽을 글</h2>
      {related.length ? <div>{related.map((item) => <article><p>{item.data.category}</p><h3><a href={articlePath(getPostSlug(item))} data-related-article data-analytics-event="related_article_click" data-analytics-article={getPostSlug(item)} data-analytics-category={categoryToSlug(item.data.category)}>{item.data.title}</a></h3><span>{readingMinutes(item)}분</span></article>)}</div> : <p class="related__empty">관련 글은 검수 후 연결합니다.</p>}
    </section>
    <ContactCta position="article-bottom" article={slug} category={categoryToSlug(post.data.category)} />
  </main>
</BaseLayout>

<style>
  .article-header { padding-top: 32px; padding-bottom: 54px; }
  .sample-notice { margin: 34px 0 24px; padding: 14px 18px; border-left: 4px solid var(--color-coral); background: #fff1ec; line-height: 1.55; }
  .sample-notice strong { margin-right: 8px; color: var(--color-coral); }
  .article-category { margin: 56px 0 16px; font: 700 .78rem var(--font-mono); letter-spacing: .06em; color: var(--color-orange-accessible); }
  .article-header h1 { max-width: 970px; margin: 0; font-size: clamp(3rem, 5vw, 4rem); line-height: 1.12; letter-spacing: -.05em; }
  .article-summary { max-width: 780px; margin: 26px 0 34px; font-size: 1.2rem; line-height: 1.75; color: var(--color-muted); }
  .article-meta { display: flex; flex-wrap: wrap; gap: 12px 30px; margin: 0; padding: 22px 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .article-meta div { display: flex; gap: 8px; }
  .article-meta dt { font: 700 .75rem var(--font-mono); color: var(--color-muted); }
  .article-meta dd { margin: 0; font-size: .86rem; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .tag-list a { display: inline-flex; min-height: 44px; align-items: center; padding: 0 12px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-blue); font-size: .82rem; text-decoration: none; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 720px) minmax(220px, 280px); justify-content: center; gap: clamp(60px, 8vw, 110px); padding-top: 54px; }
  .article-content { min-width: 0; font-size: 1.0625rem; line-height: 1.82; }
  .article-lead-diagram { margin-bottom: 56px; }
  .article-content :global(h2) { margin: 74px 0 22px; scroll-margin-top: 120px; font-size: clamp(1.9rem, 3vw, 2.45rem); line-height: 1.28; letter-spacing: -.035em; }
  .article-content :global(h3) { margin: 44px 0 16px; scroll-margin-top: 120px; font-size: 1.48rem; line-height: 1.4; }
  .article-content :global(p) { margin: 0 0 1.35em; }
  .article-content :global(a) { color: var(--color-blue); text-underline-offset: 3px; }
  .article-content :global(ul), .article-content :global(ol) { margin: 0 0 1.5em; padding-left: 1.35em; }
  .article-content :global(li) { margin: .45em 0; padding-left: .25em; }
  .article-content :global(li::marker) { color: var(--color-orange-accessible); font-weight: 800; }
  .article-content :global(ul.contains-task-list) { padding-left: 0; list-style: none; }
  .article-content :global(.task-list-item) { position: relative; padding-left: 30px; }
  .article-content :global(.task-list-item input) { position: absolute; left: 0; top: .55em; width: 18px; height: 18px; accent-color: var(--color-orange-accessible); }
  .article-content :global(blockquote:not(.callout)) { margin: 30px 0; padding: 4px 0 4px 22px; border-left: 3px solid var(--color-orange); color: var(--color-muted); }
  .article-content :global(.callout) { margin: 32px 0; padding: 22px 24px; border: 1px solid; border-left-width: 5px; background: var(--color-surface); }
  .article-content :global(.callout p:last-child) { margin-bottom: 0; }
  .article-content :global(.callout--info) { border-color: var(--color-blue); background: #edf3ff; }
  .article-content :global(.callout--warning) { border-color: var(--color-amber); background: #fff7e5; }
  .article-content :global(.callout--danger) { border-color: var(--color-coral); background: #fff0ec; }
  .article-content :global(pre) { max-width: 100%; overflow-x: auto; margin: 32px 0; padding: 22px; border-radius: 0; background: var(--color-code-background) !important; font-size: .88rem; line-height: 1.65; }
  .article-content :global(:not(pre) > code) { padding: 2px 5px; border: 1px solid var(--color-border); background: #efede8; font-size: .9em; }
  .article-content :global(table) { width: 100%; min-width: 620px; border-collapse: collapse; text-align: left; font-size: .94rem; }
  .article-content :global(caption), table caption { padding: 0 0 12px; text-align: left; font: 700 .8rem var(--font-mono); color: var(--color-muted); }
  .article-content :global(th), .article-content :global(td), table th, table td { padding: 14px 12px; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .article-content :global(thead th), table thead th { border-top: 2px solid var(--color-ink); color: var(--color-ink); background: #f0eee9; }
  .article-content :global(table) { display: block; overflow-x: auto; }
  .article-content :global(.table-scroll) { display: block; max-width: 100%; overflow-x: auto; }
  .article-content :global(.table-scroll > table) { display: table; width: 100%; min-width: 620px; overflow: visible; }
  .article-content :global(.table-scroll:focus-visible) { outline: 2px solid var(--color-blue); outline-offset: 3px; }
  .sources, .change-log, .credit-box { margin-top: 76px; padding-top: 4px; border-top: 4px solid var(--color-orange); }
  .sources > h2, .change-log > h2, .credit-box > h2 { margin-top: 28px; }
  .sources ol { padding-left: 1.3em; }
  .sources li { padding: 14px 0; }
  .sources dl { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 8px 0 0; color: var(--color-muted); font-size: .82rem; }
  .sources dl div, .credit-box dl div { display: flex; gap: 8px; }
  .sources dd, .credit-box dd { margin: 0; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  .table-scroll:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 3px; }
  .credit-box { margin-bottom: 80px; }
  .credit-box dl { display: grid; gap: 16px; margin: 0; padding: 24px; border: 1px solid var(--color-border); background: var(--color-surface); }
  .credit-box dt { min-width: 96px; font: 700 .78rem var(--font-mono); color: var(--color-muted); }
  .related { padding-top: 90px; padding-bottom: 90px; border-top: 1px solid var(--color-border); }
  .related h2 { margin: 10px 0 34px; font-size: clamp(2rem, 3vw, 2.7rem); }
  .related > div { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-ink); }
  .related article { padding: 26px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .related article:last-child { border-right: 0; }
  .related article p, .related article span { font: .75rem var(--font-mono); color: var(--color-muted); }
  .related article h3 { min-height: 72px; margin: 18px 0; line-height: 1.5; }
  .related article a { color: inherit; text-decoration-color: var(--color-orange); text-underline-offset: 5px; }
  .related__empty { color: var(--color-muted); }
  @media (max-width: 980px) {
    .article-layout { display: block; max-width: 770px; }
  }
  @media (max-width: 700px) {
    .article-header { padding-top: 20px; padding-bottom: 32px; }
    .article-category { margin-top: 36px; }
    .article-header h1 { font-size: clamp(2.25rem, 10vw, 2.7rem); }
    .article-summary { font-size: 1.05rem; }
    .article-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; }
    .article-meta div { display: grid; gap: 4px; }
    .article-layout { padding-top: 34px; }
    .article-content { font-size: 1rem; line-height: 1.78; }
    .article-lead-diagram { margin-bottom: 38px; }
    .article-content :global(h2) { margin-top: 58px; font-size: 1.85rem; }
    .article-content :global(h3) { font-size: 1.35rem; }
    .article-content :global(.callout) { margin-inline: 0; padding: 18px; }
    .related > div { grid-template-columns: 1fr; }
    .related article { border-right: 0; }
  }
</style>
