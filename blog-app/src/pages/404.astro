---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES } from '@/config/content';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="페이지를 찾을 수 없습니다 | Core Company Blog" description="요청한 블로그 페이지를 찾을 수 없습니다." canonicalPath={withBase('/404.html')} noindex nofollow>
  <main id="main-content" class="not-found section-shell" data-pagefind-ignore>
    <div class="not-found__code" aria-hidden="true">404</div>
    <div class="not-found__copy"><p>PAGE NOT FOUND / BLOG</p><h1>찾으시는 글이 없거나<br />주소가 변경되었습니다.</h1><span>검색하거나 주제별 글에서 다시 시작해 보세요.</span><div class="not-found__actions"><a class="button button--ink" href={withBase('/')}>블로그 홈</a><a class="button button--outline" href={withBase('/search/')}>글 검색</a></div></div>
    <nav aria-label="블로그 카테고리">{CATEGORIES.map((category) => <a href={withBase(`/category/${category.slug}/`)}><span>{category.name}</span><b aria-hidden="true">→</b></a>)}</nav>
  </main>
</BaseLayout>

<style>
  .not-found { display: grid; grid-template-columns: .7fr 1.3fr; gap: 50px 90px; padding-top: clamp(70px, 10vw, 140px); padding-bottom: 110px; }
  .not-found__code { font: 700 clamp(7rem, 15vw, 13rem)/.8 var(--font-mono); letter-spacing: -.08em; color: transparent; -webkit-text-stroke: 2px var(--color-border); }
  .not-found__copy > p { margin: 0 0 18px; font: 700 .78rem var(--font-mono); color: var(--color-orange-accessible); }
  .not-found h1 { margin: 0 0 22px; font-size: clamp(2.8rem, 5vw, 4.2rem); line-height: 1.13; letter-spacing: -.05em; }
  .not-found__copy > span { display: block; color: var(--color-muted); }
  .not-found__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 34px; }
  .not-found nav { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 40px; border-top: 1px solid var(--color-ink); }
  .not-found nav a { display: flex; min-height: 82px; align-items: center; justify-content: space-between; padding: 0 20px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
  .not-found nav a:nth-child(3n) { border-right: 0; }
  .not-found nav b { color: var(--color-blue); }
  @media (max-width: 800px) { .not-found { grid-template-columns: 1fr; } .not-found nav { grid-column: 1; grid-template-columns: 1fr 1fr; } .not-found nav a:nth-child(3n) { border-right: 1px solid var(--color-border); } .not-found nav a:nth-child(2n) { border-right: 0; } }
  @media (max-width: 560px) { .not-found__code { font-size: 7rem; } .not-found h1 { font-size: 2.4rem; } .not-found h1 br { display: none; } .not-found nav { grid-template-columns: 1fr; } .not-found nav a { border-right: 0 !important; } }
</style>
